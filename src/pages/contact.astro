---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contactanos" title="Protege lo que más importa con la mejor tecnología en seguridad." />
  <!-- Features2 Widget ************** -->

  <Features2
    title="Contáctanos hoy y da el primer paso hacia una vigilancia sin preocupaciones"
    items={[
      {
        title: 'Llamanos',
        description: `¡Tu seguridad no puede esperar! 📞 Llámanos ahora y descubre la mejor solución en vigilancia para tu hogar o negocio..`,
      },
      {
        title: '¿Cúal es el ideal para mi?',
        description:
          '¿Tienes dudas o necesitas una cotización? 📩 Escríbenos a nuestro correo y te ayudaremos a encontrar la mejor solución en seguridad. ¡Estamos listos para atenderte!',
      },
      {
        title: 'Donde nos encontramos',
        description:
          'Tu seguridad, más cerca de ti! 📍 Encuéntranos en la Ciudad Autónoma de Buenos Aires (CABA) y el Gran Buenos Aires (GBA). Te ofrecemos la mejor tecnología en vigilancia para proteger lo que más importa.',
      },
      {
        title: 'Teléfono',
        description: '+1 (234) 567-890',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'contact@support.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Ubicación',
        description: 'CABA y GBA',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
