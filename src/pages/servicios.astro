---
import GeminisServices from '~/components/geminis/GeminisServices.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';
import { whatsappUrl } from '~/utils/utils';

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  tagline="30 años de excelencia en alimentación"
  title="Calidad, higiene y sabor en cada platillo"
  subtitle="Con tres décadas de experiencia, garantizamos un servicio confiable y alimentos preparados con los más altos estándares de higiene y calidad. Nuestro compromiso es brindar comidas saludables y deliciosas para tu equipo, optimizando su bienestar y rendimiento."
  actions={[{ variant: 'primary', target: '_blank', text: 'Contrata ahora', href: whatsappUrl }]}
  image={{
    src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/geminis/cj7p4mdsgxcobwg8bwkv',
    alt: 'Servicio de Comedor Industrial Géminis',
  }}
/>

<GeminisServices/>

  <!-- Features2 Widget ************** -->

  <Features2
  title="Variedad y calidad en cada platillo"
  subtitle="Ofrecemos opciones equilibradas, nutritivas y adaptadas a las necesidades de tu empresa."
  columns={3}
  items={[
    {
      title: 'Nutrición balanceada',
      description:
        'Nuestros menús están diseñados por expertos en nutrición para garantizar una alimentación saludable y completa para tu equipo.',
      icon: 'tabler:heart',
    },
    {
      title: 'Ingredientes frescos',
      description:
        'Utilizamos ingredientes de alta calidad y frescura para asegurar el mejor sabor y valor nutricional en cada comida.',
      icon: 'tabler:leaf',
    },
    {
      title: 'Variedad de opciones',
      description:
        'Ofrecemos menús personalizados con diversas opciones para adaptarnos a diferentes gustos y requerimientos alimenticios.',
      icon: 'tabler:menu',
    },
    {
      title: 'Eficiencia y puntualidad',
      description:
        'Garantizamos un servicio puntual y eficiente para que tu equipo disfrute de sus comidas sin interrupciones en su jornada laboral.',
      icon: 'tabler:clock',
    },
    {
      title: 'Seguridad alimentaria',
      description:
        'Cumplimos con estrictos estándares de higiene y seguridad alimentaria para ofrecer platillos de la más alta calidad.',
      icon: 'tabler:shield-check',
    },
    {
      title: 'Atención personalizada',
      description:
        'Brindamos un servicio adaptado a las necesidades de cada empresa, con atención cercana y profesional.',
      icon: 'tabler:clock',
    }
  ]}
/>


<!-- Content Widget **************** -->

<Content
  isReversed
  items={[
    {
      title: 'Menús equilibrados',
      description:
        'Ofrecemos opciones nutritivas y balanceadas para asegurar el bienestar y rendimiento de tu equipo.',
      icon: 'tabler:heart',
    },
    {
      title: 'Personalización de menús',
      description:
        'Adaptamos nuestros platillos a las necesidades de tu empresa, considerando preferencias y restricciones alimentarias.',
      icon: 'tabler:settings',
    },
    {
      title: 'Ingredientes de calidad',
      description:
        'Utilizamos productos frescos y de alta calidad para garantizar el mejor sabor y valor nutricional en cada comida.',
      icon: 'tabler:leaf',
    },
    {
      title: 'Estrictos estándares de higiene',
      description:
        'Cumplimos con rigurosos protocolos de seguridad alimentaria para brindar un servicio confiable y saludable.',
      icon: 'tabler:shield-check',
    },
  ]}
  image={{
    src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_crop,g_auto,h_800,w_800/landings/geminis/zdzvqfzpsryi5hpkacu5',
    alt: 'Imagen de platillos saludables',
  }}
>
  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
      Compromiso con la calidad y el bienestar
    </h3>
  </Fragment>
</Content>


  <!-- Content Widget **************** -->

  <Content
  isAfterContent
  items={[
    {
      title: 'Equipo capacitado',
      description:
        'Contamos con chefs y personal altamente capacitado para ofrecer un servicio eficiente y de calidad.',
      icon: 'tabler:users',
    },
    {
      title: 'Atención personalizada',
      description:
        'Nos adaptamos a las necesidades de cada cliente, ofreciendo soluciones flexibles para garantizar la mejor experiencia.',
      icon: 'tabler:user-star',
    },
    {
      title: 'Eficiencia operativa',
      description:
        'Optimizamos nuestros procesos para brindar un servicio ágil y confiable, minimizando tiempos de espera.',
      icon: 'tabler:clock',
    },
    {
      title: 'Disponibilidad garantizada',
      description:
        'Nuestro equipo está siempre listo para atenderte, asegurando una operación continua sin interrupciones.',
      icon: 'tabler:contract',
    },
  ]}
  image={{
    src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/geminis/r1fo7elpzj2mwek4ugen',
    alt: 'Imagen del equipo en acción',
  }}
>
  <Fragment slot="content">
    <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
      Un equipo dedicado a tu servicio
    </h3>
  </Fragment>
</Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
  title="Comentarios de clientes"
  testimonials={[
    {
      testimonial: `El servicio y la calidad de los alimentos son excepcionales. Desde que contratamos este comedor, nuestros empleados están más satisfechos y su rendimiento ha mejorado. ¡Altamente recomendado!`,
      name: 'Regina Méndez',
      job: 'Gerente de Planta',
      image: {
        src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
        alt: 'Carlos Méndez Image',
      },
    },
    {
      testimonial: `La higiene y el sabor de los platillos son inigualables. Se nota el compromiso con la calidad y la nutrición. Nuestro equipo disfruta cada comida y eso se refleja en el ambiente laboral.`,
      name: 'Mariana López',
      job: 'Recursos Humanos',
      image: {
        src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
        alt: 'Mariana López Image',
      },
    },
    {
      testimonial: `Desde que implementamos este comedor industrial, hemos visto una mejora en la salud y bienestar de nuestros trabajadores. La comida es deliciosa, balanceada y siempre cumplen con los estándares de higiene.`,
      name: 'Javier Ramírez',
      job: 'Supervisor de Producción',
      image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',      
          alt: 'Javier Ramírez Image',
      },
    },
  ]}
/>

  <!-- CallToAction Widget *********** -->

  <CallToAction
  actions={[
    {
      text: 'Descargar menú',
      target: '_blank',
      href: '/geminis_menu_a_quien_corresponda.pdf',
    },
  ]}
>
  <Fragment slot="title">Descubre nuestro menú</Fragment>

  <Fragment slot="subtitle">
    Consulta un ejemplo de nuestro menú y conoce la variedad de platillos que ofrecemos.
  </Fragment>
</CallToAction>
</Layout>
