---
import GeminisContact from '~/components/geminis/GeminisContact.astro';
import GeminisServices from '~/components/geminis/GeminisServices.astro';
import GeminisStats from '~/components/geminis/GeminisStats.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import TikTokEmbed from '~/components/widgets/TikTokEmbed.astro';
import { Image } from 'astro:assets';
import GeminisDistH from '~/components/geminis/GeminisDistH.astro';
import GeminisMenu from '~/components/geminis/GeminisMenu.astro';

const metadata = {
  title: 'Sobre Nosotros',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Sobre Nosotros"
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/geminis/mlm6rbszgrznohovgvc9',
      alt: 'Imagen del qeuipo de Comedor industrial géminis',
    }}
  >
  <Fragment slot="title">
    Alimentación eficiente y saludable <br />
    <span class="text-accent dark:text-white highlight"> para tu equipo de trabajo</span>
  </Fragment>

  <Fragment slot="subtitle">
    Brindamos soluciones alimenticias de alta calidad para entornos industriales. Nuestro enfoque garantiza nutrición, eficiencia y satisfacción, permitiendo que tu equipo se enfoque en lo que mejor sabe hacer.
  </Fragment>
  </Hero>

  <GeminisDistH/>
  <!-- Stats Widget ****************** -->
  <GeminisStats />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Menús Balanceados',
        description:
          'Ofrecemos opciones alimenticias diseñadas por nutriólogos para garantizar una dieta saludable y energética.',
        icon: 'tabler:health-recognition',
      },
      {
        title: 'Higiene y Seguridad',
        description:
          'Cumplimos con los más altos estándares de calidad en la manipulación y preparación de alimentos.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Logística Eficiente',
        description:
          'Organización y distribución de comidas puntuales para grandes volúmenes de trabajadores.',
        icon: 'tabler:truck',
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale/f_auto,q_auto/v1/landings/geminis/dqgfie41axv2bceghoat',
      alt: 'Comedor industrial Geminis',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestros valores"
    subtitle="Compromiso, calidad y responsabilidad en cada platillo que servimos."
    items={[
      {
        title: 'Calidad Garantizada',
        description:
          'Cada ingrediente es seleccionado cuidadosamente para garantizar sabor y nutrición.',
      },
      {
        title: 'Compromiso con la Seguridad',
        description:
          'Cumplimos con todas las normativas sanitarias y de seguridad alimentaria.',
      },
      {
        title: 'Eficiencia y Puntualidad',
        description:
          'Entregamos cada servicio con precisión, asegurando que cada trabajador reciba su comida a tiempo.',
      },
    ]}
  />
  
  <!-- Steps2 Widget ****************** -->
  
<section class="mt-10 flex flex-col justify-start min-h-screen">
  <h2 class="text-center text-4xl font-bold mb-10">Descubré nuestro TikTok</h3>
  <TikTokEmbed videoUrl="https://www.tiktok.com/@danielaltamiran183/video/7471311802526125317" />
</section>

  
  
  <!-- CallToAction Widget *********** -->


  <GeminisMenu/>

  <!-- Features2 Widget ************** -->

  <GeminisContact/>

</Layout>
