---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import GeminisContact from '~/components/geminis/GeminisContact.astro';
import { Image } from 'astro:assets';
import TikTokEmbed from '~/components/widgets/TikTokEmbed.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contáctanos" title="Hablemos!" />

  <!-- Features2 Widget ************** -->

  <div class="flex flex-col items-center justify-center gap-2 max-w-[1024px] mx-auto " >
    <Image 
      src='https://res.cloudinary.com/dpm7xaauu/image/upload/w_250,h_250,c_limit/f_auto,q_auto/v1/landings/geminis/logos/in8dplw8u4zqjirphm5k'
      alt ='Logo Geminis'
      width="250"
      height="250"
      class="rounded-lg"
     />
  </div>
  <GeminisContact />

  <section class="mt-10 flex flex-col justify-start min-h-screen w-full">
    <h2 class="text-center text-4xl font-bold mb-10">Descubré nuestro TikTok</h3>
    <TikTokEmbed videoUrl="https://www.tiktok.com/@danielaltamiran183/video/7471311802526125317" />
  </section>
</Layout>
