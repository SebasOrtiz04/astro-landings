  />
<!-- Features Widget *************** -->
<Features
  id="servicios"
  title="Nuestros Servicios"
  subtitle="Soluciones integrales de videovigilancia para tu seguridad"
  columns={2}
  items={[
    {
      title: 'Videovigilancia',
      description:
        'Sistemas de videovigilancia de alta calidad para hogares, comercios y empresas. Monitorea en tiempo real desde cualquier lugar.',
      icon: 'line-md:watch',
    },
    {
      title: 'Instalación y Configuración',
      description: `Asesoramiento personalizado, instalación profesional y puesta en marcha de tu sistema de seguridad.`,
      icon: 'line-md:cog-loop',
    },
    {
      title: 'Mantenimiento y Soporte Técnico',
      description:
        'Servicio postventa con asistencia permanente. Mantenimiento preventivo y correctivo para garantizar el óptimo funcionamiento.',
      icon: 'line-md:construction',
    }
  ]}
/>

<!-- Pricing Widget ******************* -->

<Pricing
  title="Soluciones de Videovigilancia"
  prices={[
    {
      title: 'Hogares',
      subtitle: 'Con nuestros sistemas de CCTV podrás monitorear tu hogar en tiempo real desde cualquier lugar mediante dispositivos móviles o computadoras.',
      features: [
        'Instalación de cámaras de alta definición con visión nocturna.',
        'Acceso remoto seguro a través de aplicaciones móviles.',
        'Sistemas con detección de movimiento y notificaciones en tiempo real.',
        'Grabación y almacenamiento en la nube o dispositivos locales.',
        'Asesoría y soporte técnico especializado.',
      ],
    },
    {
      title: 'Empresas',
      subtitle: 'Controla y supervisa tus instalaciones de manera eficiente.',
      features: [
        'Instalación de cámaras IP y analógicas con alta resolución.',
        'Monitoreo en tiempo real y grabación continua.',
        'Soluciones escalables según el tamaño de la empresa.',
        'Mantenimiento preventivo y correctivo.',
      ],
    },
    {
      title: 'Comercios',
      subtitle: 'Optimiza la seguridad de tu comercio con los sistemas de CCTV de Flownet. Protege tu negocio y supervisa sus operaciones de manera eficiente.',
      features: [
        'Análisis de puntos críticos.',
        'Diseño de sistema cerrado de vigilancia.',
        'Monitoreo en vivo y grabación remota.',
      ],
    },
  ]}
>
<Fragment slot="title">
  <div class="text-gray-50"></div>
</Fragment>
</Pricing>


  <!-- FAQs Widget ******************* -->

  <FAQs
    title="¿Como contratar nuestros sevicios?"
    items={[
      {
        title: 'Consulta y Asesoramiento – Analizamos tu necesidad.',
        description:
          'Contáctanos mediante cualquier medio y nosotros te asesoraremos para llevar tu idea a cabo.',
        icon: 'tdesign:numbers-1',
      },
      {
        title: 'Propuesta Personalizada – Te presentamos la mejor solución.',
        description: `Platicando con nuestros expertos te haremos saber cual es la mejor solución que se ajuste a tus necesidades.`,
        icon: 'tdesign:numbers-2',
      },
      {
        title: 'Instalación Profesional – Dejamos el sistema funcionando.',
        description:
          'Nuestra correcta intalación permite un correcto funcionamiento a largo plazo.',
        icon: 'tdesign:numbers-3',
      },
      {
        title: 'Capacitación y Puesta en Marcha – Te enseñamos a utilizarlo.',
        description: `Te capacitamos para que tu sistema este siempre funcional.`,
        icon: 'tdesign:numbers-4',
      },
      {
        title: 'Mantenimiento y Soporte – Seguimiento y asistencia técnica.',
        description: `Damos mantenimiento a todos nuestros productos.`,
        icon: 'tdesign:numbers-5',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Content Widget **************** -->

  <Content
  title='Seguridad para todos'
    items={[
      {
        title: '¿Cúal es el ideal para mi?',
        description: `¿Tienes dudas o necesitas una cotización? 📩 Escríbenos a nuestro correo y te ayudaremos a encontrar la mejor solución en seguridad. ¡Estamos listos para atenderte!`,
      },
      {
        title: 'Hablemos sobre tu seguridad',
        description: `Protege lo que más importa con la mejor tecnología en seguridad.`,
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/tax1rg6xfeu5sd7x8xdh',
      alt: 'Cerca electrificada',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold text-gray-50 tracking-tight dark:text-white sm:text-3xl mb-2">
        Cuida de los tuyos <br /><span class="text-2xl">Da el primer paso hacia una vigilancia sin preocupaciones.</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary dark:bg-transparent"></div>
    </Fragment>
  </Content>




  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Contáctanos"
    id='contact'
    subtitle="¡Tu seguridad no puede esperar! 📞 Llámanos ahora y descubre la mejor solución en vigilancia para tu hogar o negocio."
    callToAction={{
      text: 'Chatea con nosotros',
      icon: 'tabler:brand-whatsapp',
      href: dataFacundo.whats,
      target  : '_blank',
    }}
    items={[
      {
        title: 'Email us',
        description: dataFacundo.mail,
        icon: 'line-md:email',
      },
      {
        title: 'Llámanos',
        description: dataFacundo.celular,
        icon: 'line-md:phone-call-loop',
      },
      {
        title: 'Ubicación',
        description: 'CABA y GBA',
        icon: 'line-md:map-marker-alt-loop',
      }
      // {
      //   title: 'Siguenos',
      //   description: '@example',
      //   icon: 'line-md:facebook',
      // },
    ]}
  />

