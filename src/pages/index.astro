---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'Bienvenidos ',
};
---

<Layout metadata={metadata}>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Flownet"
    actions={[
      { variant: 'primary', target: '_blank', text: 'Whats app', href: "https://wa.me/15551234567?text=I'm%20interested%20in%20your%20car%20for%20sale'" },
      { text: 'facebook', href: 'https://www.facebook.com' },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/iqcgzs5kx6a5xzpdixcc',
      alt: 'Cámaras de seguridad',
    }}
  >
    <Fragment slot="title">
      Videovigilancia para<br />Pymes, Comercios <span class="text-accent dark:text-white highlight"
        >y</span
      > Hogares<br />
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Flownet</span> es una empresa argentina especializada en sistemas de videovigilancia para pymes, comercios y hogares.</span
      >
      Brindamos soluciones de seguridad confiables y personalizadas, utilizando tecnología de vanguardia para proteger lo que más importa
    </Fragment>
  </Hero2>

  <!-- Content Widget **************** -->

  <Content
    title="¿Quienes somos?"
    id='nosotros'
    subtitle="Somos una empresa en crecimiento con el conocimiento y la experiencia para ofrecer soluciones de seguridad modernas y accesibles. Nuestro compromiso es brindar tranquilidad a través de tecnología de vanguardia y un servicio profesional de confianza."
    isReversed
    items={[
      {
        title: '¿Por que elegirnos?',
        description:
          'Brindamos soluciones a medida con equipos de última tecnología, instalación profesional y soporte postventa. Nos enfocamos en ofrecer un servicio eficiente, accesible y confiable, con atención personalizada y compromiso en cada proyecto.',
      },
      {
        title: 'Calidad',
        description: `Nuestro estandar es la calidad.`,
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/hptsxz9wwyiruw8u41n1',
      alt: 'Trabajando con taladro',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Ciudad Autónoma de Buenos Aires y Gran Buenos Aires <br /><span class="text-2xl">Cerca de tu localidad</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent={true}
    items={[
      {
        title: 'Problema: Necesidad de vigilar una entrada y areas comunes de una casa',
        description: `Solución: Instalamos cámaras con detección de movimiento.`,
      },
      {
        title: 'Resultado',
        description: `Mayor tranquilidad para la familia y acceso a las grabaciones en cualquier momento.`,
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/icxzpzhvmgjocnieclxh',
      alt: 'Cámara de sguridad colocada en un arbol',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Caso de éxito real: <br /><span class="text-2xl">Hogar</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Problema: Accesos no controlados y falta de monitoreo en zonas clave.',
        description: `Solución: Implementamos cámaras IP con visión nocturna y control de acceso.`,
      },
      {
        title: 'Resultado:',
        description: `Eliminación de ingresos no autorizados y mejor gestión de personal.`,
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_crop,x_200/f_auto,q_auto/v1/landings/flownet/ojm3we51atelkugnught',
      alt: 'Instalación de camarás industriales',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Caso de éxito: <br /><span class="text-2xl">Industria</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

    <!-- Brands Widget ****************** -->

    <Brands
    title="Marcas"
    subtitle="Manejamos diferentes marcas el cual su nombre significa calidad."
    id='brands'
    icons={[]}
    images={[
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/crx8ryh552qk5fnca3g9',
        alt: 'TP-LINK',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/xs4eo6yqeyybvidl23ev',
        alt: 'SEAGATE',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/pe1821hwrmdkgyigmxqg',
        alt: 'ALHUA',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_scale/f_auto,q_auto/v1/landings/flownet/marcas/xwebxjd9ru0fk2pxhx6k',
        alt: 'KALOP',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_scale/f_auto,q_auto/v1/landings/flownet/marcas/csg7yrw6xacvall8vhpi',
        alt: 'KINSGTON',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/kofq673yjdk1k5kfo24z',
        alt: 'HIKVISION',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/k3zgnoy89xvnfikyti4w',
        alt: 'FURUKAWA',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/p97polzgzir1gy6gprcf',
        alt: 'COMMSCOPE',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/marcas/wcw2bz6qub9ldc5hqc5k',
        alt: 'EZVIZ',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_scale/f_auto,q_auto/v1/landings/flownet/marcas/xmkl0hkeeystmeaew9nm',
        alt: 'CISCO',
      },
    ]}
  />
    <!-- Features Widget *************** -->
    <Features
    id="servicios"
    title="Nuestros servicios"
    subtitle=""
    columns={2}
    items={[
      {
        title: 'Videovigilancia',
        description:
          'Videovigilancia para Pymes, Comercios y Hogares.',
        icon: 'line-md:watch',
      },
      {
        title: 'Instalación y configuración',
        description: `Asesoramiento e instalación profesional.`,
        icon: 'line-md:cog-loop',
      },
      {
        title: 'Mantenimiento y Soporte Técnico',
        description:
          'Servicio postventa y asistencia permanente.',
        icon: 'line-md:construction',
      }
    ]}
  />
  <!-- Pricing Widget ******************* -->

  <Pricing
    title="Flexible pricing plans"
    prices={[
      {
        title: 'free',
        subtitle: 'Access to core features and a wide range of templates',
        price: '0',
        period: '/ month',
        callToAction: {
          target: '_blank',
          text: 'Get Started for Free',
          href: '#',
        },
      },
      {
        title: 'pro',
        subtitle: 'Premium templates and advanced customization',
        price: 15,
        period: '/ Month',
        callToAction: {
          target: '_blank',
          text: 'Upgrade to Pro',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Enterprise',
        subtitle: 'Tailored solutions for large-scale projects',
        price: 45,
        period: '/ Month',
        callToAction: {
          target: '_blank',
          text: 'Unlock Enterprise Features',
          href: '#',
        },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="¿Como contratar nuestros sevicios?"
    items={[
      {
        title: 'Consulta y Asesoramiento – Analizamos tu necesidad.',
        description:
          'Contactanos mediante cualquier medio y nosotros te asesoraremos para llevar tu idea a cabo.',
        icon: 'tdesign:numbers-1',
      },
      {
        title: 'Propuesta Personalizada – Te presentamos la mejor solución.',
        description: `Platicando con nuestros expertos te haremos saber cual es la mejor solución que se ajuste a tus necesidades.`,
        icon: 'tdesign:numbers-2',
      },
      {
        title: 'Instalación Profesional – Dejamos el sistema funcionando.',
        description:
          'Nuestra correcta intalación permite un correcto funcionamiento a largo plazo.',
        icon: 'tdesign:numbers-3',
      },
      {
        title: 'Capacitación y Puesta en Marcha – Te enseñamos a utilizarlo.',
        description: `Te capacitamos para que tu sistema este siempre funcional.`,
        icon: 'tdesign:numbers-4',
      },
      {
        title: 'Mantenimiento y Soporte – Seguimiento y asistencia técnica.',
        description: `Damos mantenimiento a todos nuestros productos.`,
        icon: 'tdesign:numbers-5',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Content Widget **************** -->

  <Content
    items={[
      {
        title: '¿Cúal es el ideal para mi?',
        description: `¿Tienes dudas o necesitas una cotización? 📩 Escríbenos a nuestro correo y te ayudaremos a encontrar la mejor solución en seguridad. ¡Estamos listos para atenderte!`,
      },
      {
        title: 'Hablemos sobre tu seguridad',
        description: `Protege lo que más importa con la mejor tecnología en seguridad.`,
      },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/gbeh2afd78vbhewl81q4',
      alt: 'Cerca electrificada',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Cuida de los tuyos <br /><span class="text-2xl">Da el primer paso hacia una vigilancia sin preocupaciones.</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>




  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Contactanos"
    id='contact'
    subtitle="¡Tu seguridad no puede esperar! 📞 Llámanos ahora y descubre la mejor solución en vigilancia para tu hogar o negocio."
    callToAction={{
      text: 'Whats app',
      href: "https://wa.me/15551234567?text=I'm%20interested%20in%20your%20car%20for%20sale'",
    }}
    items={[
      {
        title: 'Email us',
        description: 'Flownetsoluciones@gmail.com',
        icon: 'line-md:email',
      },
      {
        title: 'Llamanos',
        description: '+1 (234) 567-890',
        icon: 'line-md:phone-call-loop',
      },
      {
        title: 'Ubicación',
        description: 'CABA y GBA',
        icon: 'line-md:map-marker-alt-loop',
      },
      {
        title: 'Siguenos',
        description: '@example',
        icon: 'line-md:facebook',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Stay informed with AstroWind's blog"
    information={`Explore our collection of articles, guides, and tutorials on web development, design trends, and using AstroWind effectively for your projects.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
