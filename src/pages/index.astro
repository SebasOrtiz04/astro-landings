---
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Hero3 from '~/components/widgets/Hero3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';
import { dataFacundo } from '~/utils/utils';

const metadata = {
  title: 'Bienvenidos ',
};
---

<Layout metadata={metadata}>

  <!-- Hero2 Widget ******************* -->

  <Hero3
    tagline="Flownet"
    actions={[
      { variant: 'primary', target: '_blank', text: 'Contactar', icon: 'tabler:brand-whatsapp', href: dataFacundo.whats },
      { text: 'Quiero Información',icon:'tabler:mail', href: dataFacundo.mailto, target: '_blank', },
    ]}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/iqcgzs5kx6a5xzpdixcc',
      alt: 'Cámaras de seguridad',
    }}
  >
    <Fragment slot="title">
      <div class="text-gray-950">
        Videovigilancia para<br />Pymes, Comercios <span class="text-accent dark:text-white highlight"
        >y</span
        > Hogares<br />
      </div>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline text-default">
        <span class="font-semibold text-accent">Flownet</span> es una empresa argentina especializada en sistemas de videovigilancia para pymes, comercios y hogares.
        Brindamos soluciones de seguridad confiables y personalizadas, utilizando tecnología de vanguardia para proteger lo que más importa
      </span>
    </Fragment>
</Hero3>

<!-- Content Widget **************** -->

<Content
  title="Protegiendo lo que más importa"
  id="nosotros"
  subtitle="En Flownet somos expertos en soluciones de videovigilancia para hogares, negocios y empresas. Ofrecemos tecnología de punta en seguridad para garantizar tu tranquilidad."
  isReversed
  items={[
    {
      title: '¿Por qué confiar en nosotros?',
      description:
        'Nuestro equipo altamente capacitado trabaja con marcas líderes en el mercado, brindando soluciones personalizadas para cada necesidad. En Flownet, tu seguridad es nuestra prioridad.',
    },
    {
      title: 'Excelencia y compromiso',
      description: `Te ofrecemos tecnología de última generación para proteger lo que más valorás. ¡Solicitá hoy una asesoría gratuita y descubrí la mejor solución para vos!`,
    },
  ]}
  image={{
    src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/landings/flownet/hptsxz9wwyiruw8u41n1',
    alt: 'Equipo de trabajo en seguridad',
  }}
>
  <Fragment slot="content">
    <h3 class="text-2xl font-bold text-gray-50 tracking-tight dark:text-white sm:text-3xl mb-2">
      Seguridad confiable en <br /><span class="text-2xl">CABA y GBA</span>
    </h3>
    <p class="text-lg text-gray-100/80 dark:text-slate-400">
      Estamos cerca de vos para brindarte soluciones rápidas, eficientes y adaptadas a tus necesidades en seguridad electrónica.
    </p>
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-primary"></div>
  </Fragment>
</Content>



