  id="blog"
  title="Mantente informado con nuestro blog de seguridad"
  information={`Explora nuestros artículos, guías y consejos sobre sistemas de videovigilancia, tecnología de seguridad y las mejores soluciones para proteger tu hogar y negocio.`}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-gray-100 dark:bg-transparent"></div>
  </Fragment>
</BlogLatestPosts> -->

</Layout>
