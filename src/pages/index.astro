---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

import { whatsappUrl } from '~/utils/utils';

import { YouTube } from 'astro-embed';
import GeminisStats from '~/components/geminis/GeminisStats.astro';
import GeminisServices from '~/components/geminis/GeminisServices.astro';
import GeminisContact from '~/components/geminis/GeminisContact.astro';

const metadata = {
  title: 'Inicio Comedor Industrial',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Gastronomía de Calidad"
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Whatsapp',
        href: 'whatsappUrl',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Nuestros Servicios', href: '/servicios' },
    ]}
  >
  <Fragment slot="title">
    Descubre el mejor <span class="text-accent dark:text-white highlight">servicio de comedor industrial</span> para tu empresa
  </Fragment>

  <Fragment slot="subtitle">
    En <span class="font-semibold">Géminis S.A de C.V</span>, nos especializamos en ofrecer alimentación de calidad, garantizando higiene, sabor y nutrición para tus colaboradores.
  </Fragment>

    <Fragment slot="image">
      <YouTube id="gxBkghlglTg" title="Astro just Launched.... Could it be the ultimate web framework?" />
      <style is:inline>
        lite-youtube {
          margin: 0 auto;
          max-width: 100%;
        }
      </style>
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="¿Quiénes somos?"
    subtitle=`Géminis S.A de C.V cuenta con más de 30 años de experiencia en el servicio de alimentación industrial. 
    Nos especializamos en la preparación de alimentos seguros, garantizando la salud nutricional de todos nuestros comensales.`
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Stats Widget ****************** -->

  <GeminisStats/>

  <!-- Brands Widget ****************** -->

  <Brands
    title="Algunos de nuestros clientes"
    subtitle="en Géminis creemos en el trabajo en equipo y comunicación con nuestros clientes para lograr les mejores experiencias culinarias."
    icons={[]}
    images={[
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/x9bljcfvi63srvcsoxwm',
        alt: 'General Cable',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale/f_auto,q_auto/v1/landings/geminis/clients/quhgxzwk7eoqmjqwqtgh',
        alt: 'LA MORENA',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/biqtcd7d1silhuj6jzdr',
        alt: 'PRYSMIAN GROUP',
      },

      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_fill,h_48/f_auto,q_auto/v1/landings/geminis/clients/mdosb4lktw66lxmikeer',
        alt: 'DOW-QUÍMICA',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/hn3q32fqunikoltsaluv',
        alt: 'TEISA',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/xor8ztw025v3fi9r3sgc',
        alt: 'CA-LE'
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/ybmfochox9x0accxwonf',
        alt: 'GONAC',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/w_120,h_48,c_scale,h_48/f_auto,q_auto/v1/landings/geminis/clients/x9bljcfvi63srvcsoxwm',
        alt: 'PASTEURIZADORA MAULEC S.A.P.I DE C.V',
      },
      {
        src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/h_48,c_limit/f_auto,q_auto/v1/landings/geminis/clients/ertofhi18r5hzcdfsvzt',
        alt: 'DNX',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <GeminisServices/>

  <!-- Features Widget   *************** -->

  <Features
    id="features"
    title="Lo que nos hace diferentes"
    subtitle="Más de 30 años ofreciendo soluciones de alimentación empresarial con los más altos estándares de calidad y servicio."
    columns={3}
    items={[
      {
        title: 'Nutrición y Calidad Garantizada',
        description:
          'Menús diseñados por nutriólogos y chefs expertos, garantizando una alimentación equilibrada, deliciosa y saludable.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Cobertura Global',
        description:
          'Operamos en múltiples países con infraestructura de primer nivel, asegurando eficiencia y cumplimiento normativo en cada región.',
        icon: 'tabler:world',
      },
      {
        title: 'Flexibilidad y Personalización',
        description:
          'Nos adaptamos a las necesidades específicas de cada empresa, ofreciendo menús personalizados y soluciones logísticas eficientes.',
        icon: 'tabler:settings',
      },
      {
        title: 'Sostenibilidad y Responsabilidad',
        description:
          'Implementamos prácticas sostenibles en la selección de ingredientes, reducción de desperdicios y procesos operativos.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Tecnología e Innovación',
        description:
          'Utilizamos tecnología avanzada para optimizar la gestión de comedores, agilizar pedidos y mejorar la experiencia de los usuarios.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Seguridad Alimentaria de Nivel Mundial',
        description:
          'Cumplimos con estrictas normativas internacionales de higiene y seguridad para garantizar alimentos frescos y seguros.',
        icon: 'tabler:shield-check',
      },
    ]}
  />


  <!-- FAQs Widget ******************* -->

  <FAQs
  title="Preguntas Frecuentes"
  items={[
    {
      title: '¿Cómo garantizan la calidad y seguridad de los alimentos?',
      description:
        'Cumplimos con los más altos estándares internacionales en seguridad alimentaria, implementando rigurosos controles de calidad en cada etapa del proceso, desde la selección de ingredientes hasta la entrega final.',
    },
    {
      title: '¿Pueden adaptarse a necesidades dietéticas específicas?',
      description:
        'Sí, ofrecemos menús personalizados para distintas necesidades nutricionales, incluyendo dietas vegetarianas, sin gluten, bajas en sodio y más. Nuestro equipo de nutriólogos y chefs trabaja para garantizar opciones saludables y equilibradas para todos.',
    },
    {
      title: '¿En qué Estados ofrecen sus servicios?',
      description:
        'Operamos a nivel global, brindando soluciones en alimentación a empresas de diversas industrias en Tlaxcala y Puebla. Contamos con infraestructura y logística avanzada para garantizar un servicio eficiente sin importar la ubicación.',
    },
    {
      title: '¿Qué diferencia a su comedor industrial de otros proveedores?',
      description:
        'Nuestra experiencia de más de 30 años, la innovación en nuestros procesos y el compromiso con la calidad nos posicionan como un referente en la industria. Ofrecemos soluciones flexibles, nutrición especializada y un servicio eficiente adaptado a cada cliente.',
    },
    {
      title: '¿Cómo se manejan los residuos y la sostenibilidad?',
      description:
        'Nos comprometemos con la sostenibilidad mediante prácticas responsables, como la reducción de desperdicios, el uso de ingredientes locales y la implementación de programas de reciclaje. Creemos en un modelo de alimentación que respete el medio ambiente.',
    },
    {
      title: '¿Cómo puedo solicitar una propuesta o cotización?',
      description:
        'Puedes contactarnos a través de nuestro sitio web, correo electrónico o teléfono. Nuestro equipo estará encantado de analizar tus necesidades y ofrecerte una solución personalizada para tu empresa.',
    },
  ]}
>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-gray-50 dark:bg-transparent"></div>
  </Fragment>
</FAQs>


  <!-- Features3 Widget ************** -->

  <GeminisContact/>

  <!-- CallToAction Widget *********** -->

  <CallToAction
  actions={[
    {
      variant: 'primary',
      target: '_blank',
      text: 'Contáctanos',
      href: whatsappUrl, // O también podría ser 'mailto:contacto@empresa.com'
      icon: 'tabler:brand-whatsapp',
    },
  ]}
>
  <Fragment slot="title">Sé parte de nuestra familia</Fragment>

  <Fragment slot="subtitle">
    Únete a un entorno de trabajo dinámico y de crecimiento continuo, donde cada día se construye la excelencia
    en alimentación empresarial.
  </Fragment>
</CallToAction>

</Layout>
