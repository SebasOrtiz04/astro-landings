---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import rampaImg from '~/assets/images/rampa1.jpg';
import rampaImg1 from '~/assets/images/rampa2.jpg';
import rampaImg2 from '~/assets/images/rampa3.jpg';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import GetFormForm from '~/components/forms/getformForm.jsx';
import FAQs from '~/components/widgets/FAQs.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Bienvenido',
};

const whatsAppUrl = 'https://wa.me/522221275134?text=Hola%20Estaba%20en%20tu%20sitio%20y%20quiero%20información%20sobre%20el%20infblable.'
---

<Layout metadata={metadata}>
  
  <!-- Hero2 Widget ******************* -->

  <Hero
    tagline="Inflables Orca"
    title="¡Rentame para tus fiestas!"
    subtitle="Renta este divertido inflable de 6m x 4m a tan solo $850.00 MXN."
    actions={[
      { variant: 'secondary', text: 'Contáctanos', href: whatsAppUrl, icon: 'tabler:brand-whatsapp', target: '_blank' },
      // { text: 'Facebook', href: 'https://www.facebook.com/profile.php?id=61569751381424', icon: 'tabler:brand-facebook', target: '_blank' },
    ]}
    image={{
      src: rampaImg,
      alt: 'Inflable Rampa',
    }}
  />
  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Aparta con $200.00 MXN',
        description:
          'Contáctanos por whatsapp para verificar disponibilidad y aparta tu fecha con solo $200.00 MXN',
      },
      {
        title: 'Horarios de renta flexibles',
        description:
          'Entendemos que todos los eventos son diferentres. No te preocupes por el horario, nos adaptamos a tus necesidades.',
      },
      {
        title: 'En la puerta de tu hogar',
        description:
          'Contamos con servicio en la ciudad de Puebla y Cholula.',
      },
      {
        title: 'Limpio y desinfectado',
        description: `Por la higiene sientete seguro te entregamos el inflable limpio y desinfectado.`,
      },
    ]}
    image={{
      src: rampaImg1,
      alt: 'Inflable rampa de noche',
    }}
  >
    <Fragment slot="content">Solo aparta y nos hacemos cargo del resto</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  
  
  
  <FAQs
  title="Preguntas frecuentes"
  subtitle="Nuestros clientes suelen tener preguntas similares. Recuerda, cualquier duda adicional podemos resolverla por WhatsApp."
  tagline="FAQs"
  classes={{ container: 'max-w-6xl' }}
  items={[
      {
        title: '¿El inflable se entrega y se instala en mi evento?',
        description:
          "Sí, nuestro equipo se encarga de entregar e instalar el inflable en la ubicación de tu evento. Solo necesitamos un espacio plano y accesible para asegurar una instalación adecuada.",
        },
      {
        title: '¿Cuánto tiempo puedo rentar un inflable?',
        description:
          "El tiempo de renta estándar es de 6 a 8 horas, pero podemos ajustar según tus necesidades. Consulta con nosotros si requieres un horario extendido.",
        },
      {
        title: '¿Cuando se retira el inflable de mi evento?',
        description:
          "El infblable se retira al término del evento acordado a la hora de contratación. Nos encargamos de limpiarlo y de mantenerlo en buen estado para su reutilización.",
        },
      {
        title: '¿Es seguro para los niños jugar en los inflables?',
        description:
          "Los inflables son muy divertidos y en general no suelen representar un peligro para los niños sin ambargo recomendamos siempre la supervisión de un adulto mientras se usan.",
        },
      {
        title: '¿Necesito acceso a electricidad para instalar un inflable?',
        description:
          "Sí, los inflables necesitan una toma de corriente cercana para operar el motor que los mantiene inflados.",
        },
      {
        title: '¿Qué tipo de inflables ofrecen para renta?',
        description:
          "Actualmente contamos con una rampa de 4m x 6m la cual se muestra en las fotos de este sitio.",
        },
    ]}
  />

  <div class="flex flex-col items-center justify-center h-40">
    <Button 
    text='WhatsApp'
    icon="tabler:brand-whatsapp"
    href={whatsAppUrl}
    target="_blank"
    />
  </div>

  <!-- Steps Widget ****************** -->
  <Steps
    title="Para rentar el inflable sigue los siguientes pasos."
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Contáctanos</span>',
        description:
          "Mandanos mensaje por whatsapp o dejanos tu contacto y fecha de interes y nos pondremos en contacto con tigo.",
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Paso 2: <span class="font-medium">Verifica disponibilidad</span>',
        description:
          "Confirma la disponibilidad para el día de tu fiesta.",
        icon: 'tabler:calendar-check',
      },
      {
        title: 'Paso 3: <span class="font-medium">Aparta la fecha</span>',
        description:
          'Tenemos pago con efectivo, y transferencia. Elije la que mejor te acomode',
        icon: 'tabler:paywall',
      },
      {
        title: 'Todo listo para tu fiesta!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: rampaImg2,
      alt: 'Steps image',
    }}
  />
  
  <GetFormForm client:load/>

</Layout>
