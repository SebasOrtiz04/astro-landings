---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import GetformForm from '~/components/forms/getformForm.jsx';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/LandingLayout.astro';
import ShowTableWare from '~/components/widgets/ShowTableWare.astro';
import Steps from '~/components/widgets/Steps.astro';
import { priceTableWare } from '~/data/precios-lozas';
import { razones } from '~/data/razones-nosotros'
import { pasosContratar } from '~/data/pasos-contratar'
import { carouselPhotos } from '~/data/carousel-photos';


const metadata = {
  title: 'Alquiler Orca',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar información',
        href: '#formulario',
      }
    ]}
    galleryItems={carouselPhotos}
  >
    <Fragment slot="title">
      ¿Tienes un evento especial <span class="hidden xl:inline"> en puerta</span>?
      <span class="block"><span class="text-accent highlight">Alquila</span> la mejor vajilla con nosotros</span>
    </Fragment>
  </Hero>
  
  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Diferenciador"
    title="¿Por qué rentar con nosotros?"
    items={razones}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="¿Cómo contratar nuestro servicio?"
    items={pasosContratar}
    image={{
      src: 'https://res.cloudinary.com/dpm7xaauu/image/upload/c_limit,h_350,w_500/v1/landings/alquiler-orca/Plato Cuadrado/famxw3c6esjrpch7jgow',
      alt: 'Imagen de loza',
    }}
  />

  <!-- Productos ******************* -->
  <ShowTableWare
    id="Productos"
    title="Loza disponible"
    subtitle="Esta es la variedad de loza que tenemos para ti."
    columns={3}
    items={priceTableWare}
  />

  <!-- Formulario -->

  <div id="formulario">
    <GetformForm client:load />
  </div>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        text: 'Contactar',
        href: 'https://wa.link/toaifx',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Contáctenos&nbsp;<span class="sm:hidden md:inline">via whatsapp</span>
    </Fragment>
  </CallToAction>

</Layout>
