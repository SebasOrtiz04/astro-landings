---
import { whatsappUrl } from "~/utils/utils";
import Features3 from "../widgets/Features3.astro";

---

<Features3
title="Cuentanos cómo podemos ayudarte"
subtitle="Estamos aquí para ayudarte y responder cualquier pregunta que tengas."
columns={3}
items={[
  {
    title: 'Teléfono',
    icon: 'tabler:phone',
    callToAction: {
      target: '_blank',
      text: '+52 1 276 137 8764',
      href: 'tel:+5212761378764',
      variant: 'link',
    },
  },
  {
    title: 'Email',
    icon: 'tabler:mail',
    callToAction: {
      target: '_blank',
      text: 'danielaltamiranogarcia@outlook.com',
      href: 'mailto:danielaltamiranogarcia@outlook.com',
      variant: 'link',
    },
  },
  {
    title: 'Whatsapp',
    icon: 'tabler:brand-whatsapp',
    callToAction: {
      target: '_blank',
      text: 'Chatéa con nosotros',
      href: whatsappUrl,
      variant: 'link',
    },
  }
]}
/>