---
import { Image } from "astro:assets";
import Features2 from "../widgets/Features2.astro";

---

<section class="flex flex-col items-center justify-start gap-2 max-w-[1024px] mx-auto " >
  <Features2
    title="Distintivo H"
    subtitle="En Comedor Industrial Géminis, la seguridad alimentaria es nuestra prioridad. Contamos con el Distintivo H, una certificación otorgada por la Secretaría de Turismo y la Secretaría de Salud en México, que garantiza el cumplimiento de los más altos estándares de higiene en la manipulación, almacenamiento y preparación de alimentos."
    items={[
      {
        title: 'Alimentos seguros y libres de contaminación',
        icon: 'tabler:vacuum-cleaner',
      },
      {
        title: 'Personal capacitado en normativas sanitarias',
        icon: 'tabler:certificate',
      },
      {
        title: 'Instalaciones inspeccionadas y certificada',
        icon: 'tabler:building',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <article class="flex flex-col lg:flex-row gap-16 justify-space-between items-center my-10 w-full">
    <Image class:list={'shadow-xl'} src="https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/WhatsApp_Image_2026-07-16_at_10.27.14_AM_2_amiqi1" alt="Geminis menu a quien corresponda" width="200" height="300" class="rounded-lg w-full lg:w-1/2" />
      
    <Image class:list={'shadow-xl'} src="https://res.cloudinary.com/dpm7xaauu/image/upload/f_auto,q_auto/v1/WhatsApp_Image_2026-07-15_at_7.18.01_PM_2_c0joa0" alt="Geminis menu a quien corresponda" width="350" height="451" class="rounded-lg w-full lg:w-1/2" />
  </article>
</section>